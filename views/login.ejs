<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muumi Sanonnat</title>
    <style>
        body{
            background-color: rgb(1, 33, 46);
            color: rgb(245, 165, 113);
        }

        #login_form{
            margin-top: 200px;
        }

        #submit_button{
            background-color:rgb(247, 96, 50);
            color: rgb(1, 33, 46);
            padding: 5px 30px;
            border-radius: 15px;
            border: 0px;
        }

        #submit_button:hover {
            background-color: rgb(245, 165, 113);
            color: rgb(1, 33, 46);
        }

    </style>
</head>  
    <body>
        <center>
        <form method="post" id="login_form" action="/login">
            <p>
                <label for="username">Username:</label>
                <input type="text" name="username">                
            </p>
            <p>
                <label for="password">Password:</label>
                <input type="password" name="password">                
            </p>
            <p>
                <input type="submit" id="submit_button" value="Login">
            </p>        
        </form>
        </center>
    </body>
</html>